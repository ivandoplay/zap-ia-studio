# Porta local do Motor WhatsApp (Termux / PC — padrão: 3000)
PORT=3000

# ==============================================================================
# NUVEM MULTI-CONTAS (SUPABASE + VERCEL)
# ==============================================================================
# SUPABASE_URL e SUPABASE_ANON_KEY já vêm pré-configurados por padrão no sistema!
# Na Vercel (Settings > Environment Variables), configure:
#   SUPABASE_URL=https://iuysmojhaxplnhfrxqkv.supabase.co
#   SUPABASE_ANON_KEY=sua_anon_key_publica
#   SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta (APENAS NA VERCEL — NUNCA NO CLIENTE/TERMUX!)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: Você pode colar suas chaves de IA direto pelo Painel Visual na aba "Motor de IA":
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ==============================================================================
# EVOLUTION GO (webhook server — serviço 'webhook' no docker-compose)
# ==============================================================================
# URL do pool/API do Evolution Go
EVOLUTION_GO_URL=https://pool-evolution-go-025.cloud2.pageup.dev.br
# Chave global da API (endpoints de instância — /instance/all, /instance/connect)
EVOLUTION_GO_API_KEY=de641771b68731fb4340696241bd2cd6
# Mapa instância Evolution Go → user_id Supabase (multi-tenant, JSON)
# Ex: {"ienvia-teste-06a36777":"uuid-do-usuario"}
EVOLUTION_INSTANCE_USERS=
# user_id padrão do Supabase (se não usar o mapa acima)
EVOLUTION_DEFAULT_USER_ID=
# Após deploy, rode: ./scripts/evolution-setup.sh http://<vps-ip>:3001/webhook
# (configura a webhookUrl nas instâncias conectadas do Evolution Go)
