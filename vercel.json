{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{src/**,public/**,scripts/**,dist_kit/**,release/**,data/training_packs/**,package.json,package-lock.json,vercel.json,.npmrc,.env.example,LEIA-ME_COMO_USAR.md,*.bat,*.sh}"
    }
  },
  "crons": [
    {
      "path": "/api/campaigns-v2/schedule/tick",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/venda",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/venda.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/contas",
      "destination": "/v2/accounts.html"
    },
    {
      "source": "/contas/",
      "destination": "/v2/accounts.html"
    },
    {
      "source": "/configuracoes",
      "destination": "/api/index.js"
    },
    {
      "source": "/configuracoes/",
      "destination": "/api/index.js"
    },
    {
      "source": "/inteligencia-artificial",
      "destination": "/api/index.js"
    },
    {
      "source": "/inteligencia-artificial/",
      "destination": "/api/index.js"
    },
    {
      "source": "/simulador",
      "destination": "/api/index.js"
    },
    {
      "source": "/simulador/",
      "destination": "/api/index.js"
    },
    {
      "source": "/catalogo",
      "destination": "/api/index.js"
    },
    {
      "source": "/catalogo/",
      "destination": "/api/index.js"
    },
    {
      "source": "/audios",
      "destination": "/api/index.js"
    },
    {
      "source": "/audios/",
      "destination": "/api/index.js"
    },
    {
      "source": "/treinamento",
      "destination": "/api/index.js"
    },
    {
      "source": "/treinamento/",
      "destination": "/api/index.js"
    },
    {
      "source": "/campanhas",
      "destination": "/api/index.js"
    },
    {
      "source": "/campanhas/",
      "destination": "/api/index.js"
    },
    {
      "source": "/conversas",
      "destination": "/api/index.js"
    },
    {
      "source": "/conversas/",
      "destination": "/api/index.js"
    },
    {
      "source": "/historico",
      "destination": "/api/index.js"
    },
    {
      "source": "/historico/",
      "destination": "/api/index.js"
    },
    {
      "source": "/instancias",
      "destination": "/api/index.js"
    },
    {
      "source": "/instancias/",
      "destination": "/api/index.js"
    },
    {
      "source": "/canais",
      "destination": "/api/index.js"
    },
    {
      "source": "/canais/",
      "destination": "/api/index.js"
    },
    {
      "source": "/conexoes",
      "destination": "/v2/connections.html"
    },
    {
      "source": "/conexoes/",
      "destination": "/v2/connections.html"
    },
    {
      "source": "/visao-geral",
      "destination": "/v2/index.html"
    },
    {
      "source": "/visao-geral/",
      "destination": "/v2/index.html"
    },
    {
      "source": "/painel",
      "destination": "/painel.html"
    },
    {
      "source": "/app",
      "destination": "/painel.html"
    },
    {
      "source": "/vitrine",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.vercel.app https://*.e2b.app http://localhost:* http://127.0.0.1:*"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/painel",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/painel.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/atualizar.sh",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/v2/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/visao-geral/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/conexoes/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/canais/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/instancias/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "review/reforma-visual": false
    }
  }
}
